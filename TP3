def Simuvasicek(N, gamma, dt, eta, sigma):
    tab_r = [0.023]

    for i in range(N-1):
        # Calcul de r 
        r_next = tab_r[-1]*np.exp(-gamma*dt) + eta/gamma*(1-np.exp(-gamma*dt)) + sigma*np.sqrt((1-np.exp(-2*gamma*dt))/(2*gamma)) * np.random.randn()
        tab_r.append(r_next)

    return tab_r[:-1], tab_r[1:]


