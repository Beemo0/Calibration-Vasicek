# Partie I
def Vasicek (r0):
    T = np.arange(0.1, 30, 1)
    P = np.zeros(len(T))
    A = np.zeros(len(T))
    B = np.zeros(len(T))
    Y1 = np.zeros(len(T))
    Y2 = np.zeros(len(T))

    for i in range(len(T)):
        to = T[i] - t  
        B[i] = (1 - np.exp(-gamma * to)) / gamma
        A[i] = (B[i] - to) * ((eta * gamma - (sigma**2) / 2) / gamma**2) - (((sigma**2) * B[i]**2) / (4 * gamma))
        P[i] = np.exp(A[i] - (r0 * B[i]))
        Y1[i] = -np.log(P[i]) / to
        Y2[i] = -(A[i] - r0 * B[i]) / to
    plt.plot(T, Y1, label=f"r0 = {r0}")
        
